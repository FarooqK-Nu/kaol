# Node API
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://kaol_user:kaol_password@localhost:5432/kaol_db
REDIS_URL=redis://localhost:6379
ML_SERVICE_URL=http://localhost:8000
STORAGE_LOCAL_ROOT=../../data/jobs
MAX_UPLOAD_SIZE_MB=200

# Frontend Web
VITE_API_BASE_URL=http://localhost:3000
VITE_JOB_POLL_INTERVAL_MS=3000
VITE_MAX_UPLOAD_SIZE_MB=200

# Python ML Service
ML_HOST=127.0.0.1
ML_PORT=8000
WORKSPACE_DIR=../../data/jobs
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
