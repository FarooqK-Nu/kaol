{
  "name": "kaol-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --filter @kaol/api dev",
    "dev:web": "bun --filter @kaol/web dev",
    "dev:ml": "cd services/ml-service && .venv/Scripts/python -m uvicorn app.main:app --reload --port 8000",
    "build": "bun run --filter \"*\" build",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "test": "bun run --filter \"*\" test"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "debug": "^4.4.3",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  }
}
